{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndWriteMapObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::YOUR_BUCKET/maptable/*"
    },
    {
      "Sid": "DistinguishNewWorkspaceFromAccessDenied",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR_BUCKET"
    }
  ]
}
