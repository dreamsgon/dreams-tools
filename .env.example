# Copy to .env.local for development. Never commit the filled copy.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Required persistent map storage. Use a private general-purpose S3 bucket.
MAPTABLE_S3_BUCKET=your-maptable-bucket
MAPTABLE_S3_PREFIX=maptable
MAPTABLE_AWS_REGION=us-east-1
MAPTABLE_AWS_ACCESS_KEY_ID=YOUR_IAM_ACCESS_KEY_ID
MAPTABLE_AWS_SECRET_ACCESS_KEY=YOUR_IAM_SECRET_ACCESS_KEY
# MAPTABLE_AWS_SESSION_TOKEN=ONLY_FOR_TEMPORARY_CREDENTIALS

# Optional additional, account-scoped image collection in the same AWS region.
# S3_BUCKET=your-extra-image-bucket
# S3_PREFIX=maptable/

# Optional: locks the AI API keys GMs save under Connect an AI. Any long random string.
# Without it, the S3 secret above is used; changing whichever is used means GMs paste their keys again.
# AI_KEY_SECRET=
