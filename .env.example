# Copy to .env.local for development. Never commit the filled copy.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Required persistent map storage. Use a private general-purpose S3 bucket.
MAPTABLE_S3_BUCKET=your-maptable-bucket
MAPTABLE_S3_PREFIX=maptable
MAPTABLE_AWS_REGION=us-east-1
MAPTABLE_AWS_ACCESS_KEY_ID=YOUR_IAM_ACCESS_KEY_ID
MAPTABLE_AWS_SECRET_ACCESS_KEY=YOUR_IAM_SECRET_ACCESS_KEY
# MAPTABLE_AWS_SESSION_TOKEN=ONLY_FOR_TEMPORARY_CREDENTIALS

# Optional additional, account-scoped image collection in the same AWS region.
# S3_BUCKET=your-extra-image-bucket
# S3_PREFIX=maptable/

# Optional: the server's own secret for signed links and hashes (invite links, player dice and sheets, avatars). Any long
# random string. Without it, the S3 secret above is used. AI API keys are never saved on the server: they stay in each
# GM's or player's browser. (Older versions locked saved AI keys with this; those move to the GM's browser on their next visit.)
# AI_KEY_SECRET=

# Optional: "Sign in with Google and pick the sheet" for character sheets (Encyclopedia). Without all three, the dialog
# offers published links only. These are public by design (they ship to the browser); the OAuth client has no secret
# here and the access token never reaches this server. Setup steps: docs/ENCYCLOPEDIA.md, Character sheets.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_API_KEY=YOUR_BROWSER_API_KEY_RESTRICTED_TO_PICKER_AND_SHEETS
# The Google Cloud project NUMBER (digits), which the file picker needs.
# NEXT_PUBLIC_GOOGLE_APP_ID=1234567890

# Optional: the public address Discord fetches roll-card avatars from. On Vercel the production domain is used automatically.
# APP_ORIGIN=https://your-app.example.com

# Optional: "Sign in with GitHub" for campaign repositories (GitHub & backups), instead of pasting a key. All three, or
# none: without them the dialog asks for a fine-grained key as before. The secret stays on the server and is only used to
# swap GitHub's sign-in code for the GM's key, which goes straight back to their browser. Setup: docs/GITHUB_APP.md.
# GITHUB_APP_CLIENT_ID=Iv23...
# GITHUB_APP_CLIENT_SECRET=
# NEXT_PUBLIC_GITHUB_APP_SLUG=rpg-tools
